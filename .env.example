# Haslo do bazy - wymagane, bez tego zaden kontener nie wstanie.
POSTGRES_PASSWORD=change-me

# Porty na hoscie (w kontenerach nic sie nie zmienia).
# Ustaw inne, jesli domyslne sa zajete: netstat -ano | findstr :8081
WACHTA_API_PORT=8080
WACHTA_WEB_PORT=8081

# Klucze zrodel danych - opcjonalne, opis w docs/SOURCES.md.
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
FIRMS_MAP_KEY=
GFW_TOKEN=
